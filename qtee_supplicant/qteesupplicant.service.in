[Unit]
Description=QTEE Supplicant Service
ConditionPathExists=/dev/tee0
After=sfsconfig.service

[Service]
Type=exec
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/qtee_supplicant
Restart=always

[Install]
WantedBy=multi-user.target
